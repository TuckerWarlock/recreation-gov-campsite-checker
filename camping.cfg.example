# -------------------------------------------------------
# Campsite checker configuration
# Edit this file, then run ./check.sh with no arguments.
# -------------------------------------------------------

# --- Dates to check (required) ---
START_DATE=2025-07-23
END_DATE=2025-07-28

# --- Parks to check ---
# Space-separated recreation.gov campground IDs.
# Leave blank to check all 15 Yosemite campgrounds.
# White Wolf only:
PARKS=10083567

# --- ntfy.sh push notifications (optional, recommended) ---
# Free, open-source push notifications to your phone.
# 1. Install the ntfy app: https://ntfy.sh
# 2. Subscribe to the topic name below in the app.
# ⚠️  Anyone who knows your topic name can subscribe — make it unguessable
#     or use a self-hosted ntfy server for privacy.
NTFY_TOPIC=yosemite-white-wolf

# --- Email notification (optional) ---
# Uses Gmail with an App Password (same setup as ping-test).
# Leave all three blank to disable.
#
# App Password setup (takes ~2 minutes):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces are fine).

EMAIL_ADDRESS=
EMAIL_PASSWORD=
NOTIFY_EMAIL=
