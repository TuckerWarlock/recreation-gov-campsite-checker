# -------------------------------------------------------
# Campsite checker configuration
# Edit this file, then run ./check.sh with no arguments.
# -------------------------------------------------------

# --- Dates to check (required) ---
START_DATE=2025-07-23
END_DATE=2025-07-28

# --- Parks to check ---
# Space-separated recreation.gov campground IDs.
# Leave blank to check all 15 Yosemite campgrounds.
# White Wolf only:
PARKS=10083567

# --- Email / SMS notification (optional) ---
# Sends an alert when a site opens up. Uses Gmail with an App Password.
# Leave all three blank to disable.
#
# App Password setup (takes ~2 minutes):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces are fine).
#
# To receive a text instead of email, use your carrier's email-to-SMS gateway:
#   Verizon:   5551234567@vtext.com
#   AT&T:      5551234567@txt.att.net
#   T-Mobile:  5551234567@tmomail.net
#   Sprint:    5551234567@messaging.sprintpcs.com

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=
